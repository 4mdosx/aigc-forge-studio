{
  "batch": "mecha-core",
  "createdAt": "2026-11-23T21:30:00+08:00",
  "updatedAt": "2026-11-23T15:06:26.033Z",
  "line": "主线：剥离背景的高精度二次元机娘立绘",
  "architecture": {
    "mode": "two-stage",
    "rationale": "韩系质感与机娘结构在现有池里交集为零（按质感质心排序 top120 中机娘 0 张，全池 86 张机娘无一进入该簇），无法用单只 LoRA 一次学两件事。拆成两段后每段只学一件事，冲突从『权重里打架』变成『推理时用 denoise 调』。",
    "stages": [
      {
        "id": "struct",
        "order": 1,
        "role": "底图：白底全身机娘的构图、机械结构、人体比例",
        "model": "LoRA A（结构），unet_only，dim 64",
        "dataset": "mecha_core_anchor",
        "profile": "style-anchor/profile.json",
        "note": "质感不纯可以容忍——底图的质感会被第二阶段 repaint 覆盖，只要骨架与比例对"
      },
      {
        "id": "gloss",
        "order": 2,
        "role": "质感：韩系半厚涂、亮面材质、软边、写实人体表达",
        "model": "LoRA B（质感，权重 0.4-0.6）或 IPAdapter",
        "dataset": "mecha_core_style",
        "profile": "style-anchor/profile-gloss.json",
        "input": "阶段 1 输出的底图",
        "params": "img2img，denoise 0.40-0.50",
        "note": "denoise 低于 0.35 质感刷不上去（hires 那轮实测 0.35 等于没做），高于 0.55 会改构图与机械结构"
      }
    ],
    "measured": {
      "crossClusterCosine": 0.69,
      "intraGlossCosine": 0.668,
      "intraStructCosine": 0.603,
      "saturation": {
        "struct": 0.276,
        "gloss": 0.284
      },
      "lapVar": {
        "struct": 919,
        "gloss": 538
      },
      "conclusion": "两簇的差异不在配色（饱和度几乎相同），而在细节密度差 41%。repaint 调的正是这一个轴，所以两段式的风险边界清晰。"
    }
  },
  "criteriaVersion": "v3",
  "spec": "notes/11_learning/AIGC/05 资产收集规范",
  "mediaPolicy": {
    "rating": "struct 段只要 general；gloss 段放开到 sensitive（高质量全在 sensitive：NIKKE general 4156 vs sensitive 31516），不开 explicit",
    "format": "竖幅，aspect = h/w ≥ 1.15，长边 ≥ 1400",
    "background": "struct 段必须白底或纯色底；gloss 段不限（repaint 不需要背景干净）",
    "single": "一张图一个角色，禁止换装设定表/多人物同框/UI 截图",
    "finished": "成图，禁止线稿/灰模/草图",
    "caption": "artist/copyright 不进 caption；角色名一律不写"
  },
