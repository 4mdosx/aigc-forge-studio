{
  "id": "mecha-panel",
  "name": "机甲面板生成器",
  "description": "在 Blender 当前 Scene 里按参数生成一组可编辑的机械面板。源码在工作台只读，改动请直接编辑 scripts/main.py。",
  "entry": "scripts/main.py",
  "files": [
    "scripts/main.py"
  ],
  "variables": {
    "count": {
      "type": "number",
      "label": "面板数量",
      "default": 6,
      "min": 1,
      "max": 32,
      "step": 1
    },
    "width": {
      "type": "number",
      "label": "面板宽度",
      "default": 0.8,
      "min": 0.1,
      "max": 4,
      "step": 0.1
    },
    "seed": {
      "type": "number",
      "label": "随机种子",
      "default": 1,
      "min": 0,
      "max": 99999,
      "step": 1
    },
    "prefix": {
      "type": "string",
      "label": "物体名前缀",
      "default": "Panel"
    },
    "clearExisting": {
      "type": "boolean",
      "label": "先清除同名物体",
      "default": true
    }
  }
}
