{
  "version": 2,
  "theme": "canonical-bank",
  "note": "全库题材表库：global 是兜底层（未命中任何题材时只用这一层），themes 按 router 专有 tag 打分命中。recomposeCanonical 引擎不变，命中后 global 与题材表合并再喂给它。换题材/加题材只维护这个文件。",
  "tokenBudget": 15,
  "global": {
    "drop": [
      "blurry", "lowres", "worst_quality", "low_quality", "normal_quality",
      "jpeg_artifacts", "compression_artifacts", "watermark", "signature",
      "username", "text", "blurry_background", "motion_blur", "out_of_focus",
      "masterpiece", "best_quality", "high_quality", "ultra_detailed",
      "highly_detailed", "highres", "absurdres", "4k", "8k",
      "breasts", "large_breasts", "huge_breasts", "small_breasts", "cleavage",
      "thighs", "thick_thighs", "legs", "lips", "parted_lips", "skindentation",
      "collarbone", "navel", "mole", "sweat", "censored", "mosaic_censoring"
    ],
    "rules": [
      { "slot": "identity", "match": ["solo", "solo_focus", "1girl"], "output": "1girl" },
      { "slot": "gaze", "match": ["looking_at_viewer"], "output": "looking at viewer" }
    ],
    "order": ["trigger", "identity", "theme", "pose", "gaze", "other"]
  },
  "themes": {
    "bunny-girl-bar": {
      "version": 1,
      "theme": "bunny-girl-bar",
      "note": "兔女郎酒吧场景：目标是把 61 个 WD14 tag 压成约 12 个词组的生产 prompt。",
      "router": ["playboy_bunny", "bunny_girl", "rabbit_ears", "fake_animal_ears", "highleg_leotard", "strapless_leotard"],
      "tokenBudget": 15,
      "order": ["trigger", "identity", "theme", "ears", "outfit", "legwear", "gloves", "shoes", "hair", "pose", "gaze", "other"],
      "drop": [
        "bar", "bar_(place)", "indoors", "room", "drinking_glass", "wine_glass",
        "cocktail_glass", "cup", "bottle", "wine_bottle", "beer_bottle", "alcohol",
        "drink", "bar_stool", "stool", "chair", "table", "counter", "holding",
        "holding_cup", "sideboob", "thigh_strap", "armlet", "dutch_angle",
        "off_shoulder", "detached_collar", "bare_shoulders", "fur_trim",
        "fur-trimmed_coat", "hair_ornament", "coat", "black_coat",
        "multicolored_hair", "yellow_eyes", "red_eyes", "solo"
      ],
      "rules": [
        { "slot": "theme", "match": ["playboy_bunny", "bunny_girl", "bunny"], "output": "playboy bunny" },
        {
          "slot": "ears",
          "match": ["animal_ears", "rabbit_ears", "fake_animal_ears", "ears"],
          "compose": {
            "template": "{type} ears",
            "parts": {
              "type": {
                "map": { "rabbit_ears": "rabbit", "animal_ears": "rabbit", "fake_animal_ears": "rabbit" },
                "default": "rabbit"
              }
            }
          }
        },
        {
          "slot": "outfit",
          "match": ["leotard", "black_leotard", "highleg_leotard", "strapless_leotard", "highleg", "strapless"],
          "compose": {
            "template": "{color} {cut} leotard",
            "parts": {
              "color": { "map": { "black_leotard": "black", "black": "black" }, "default": "black" },
              "cut": { "map": { "highleg_leotard": "highleg", "highleg": "highleg" }, "default": "highleg" }
            }
          }
        },
        { "slot": "legwear", "match": ["pantyhose", "black_pantyhose"], "output": "black pantyhose" },
        { "slot": "gloves", "match": ["gloves", "black_gloves"], "output": "black gloves" },
        { "slot": "shoes", "match": ["high_heels", "black_footwear", "heels"], "output": "high heels" },
        {
          "slot": "hair",
          "match": ["long_hair", "very_long_hair", "purple_hair", "black_hair", "hair"],
          "compose": { "template": "long multicolored hair", "parts": {} }
        },
        { "slot": "pose", "match": ["full_body", "standing"], "output": "full body" },
        { "slot": "gaze", "match": ["looking_at_viewer"], "output": "looking at viewer" }
      ]
    },
    "kimono-classic": {
      "version": 1,
      "theme": "kimono-classic",
      "note": "和服角色（赤城等）：白无垢/振袖 + 腰带，服装必须 fully clothed，去掉场景杂物。",
      "router": ["kimono", "japanese_clothes", "yukata", "obi", "hakama", "akagi"],
      "tokenBudget": 15,
      "order": ["trigger", "identity", "theme", "outfit", "obi", "hair", "legwear", "pose", "gaze", "other"],
      "drop": [
        "indoors", "room", "table", "chair", "holding", "cup", "bottle",
        "drinking_glass", "western_clothes", "dress", "swimsuit", "nude",
        "topless", "bare_breasts", "open_clothes", "dutch_angle"
      ],
      "rules": [
        { "slot": "theme", "match": ["kimono", "japanese_clothes", "yukata", "hakama"], "output": "white kimono" },
        { "slot": "outfit", "match": ["fully_clothed", "clothed", "white_kimono"], "output": "fully clothed" },
        { "slot": "obi", "match": ["obi", "sash", "waist_bow", "obiage"], "output": "obi sash" },
        {
          "slot": "hair",
          "match": ["long_hair", "very_long_hair", "black_hair", "hair_ornament", "kanzashi"],
          "compose": { "template": "long black hair with ornament", "parts": {} }
        },
        { "slot": "legwear", "match": ["tabi", "tabi_socks", "socks", "thighhighs"], "output": "tabi socks" },
        { "slot": "pose", "match": ["full_body", "standing", "sitting"], "output": "full body" }
      ]
    },
    "mecha-musume": {
      "version": 1,
      "theme": "mecha-musume",
      "note": "机娘/舰装：厚重一体化装甲 + 白烤漆大块装甲板 + 黑光面 bodysuit + 金色机械关节；压制废土与线缆先验。",
      "router": ["mecha_musume", "mecha", "mechanical", "powered_armor", "flight_deck", "rigging", "body_armor"],
      "tokenBudget": 15,
      "order": ["trigger", "identity", "theme", "armor", "material", "gear", "hair", "pose", "gaze", "other"],
      "drop": [
        "rust", "weathering", "wasteland", "post-apocalyptic", "dirty", "torn",
        "cables", "wires", "exposed_wiring", "glowing_eyes", "dutch_angle",
        "landscape", "sky", "clouds", "outdoors"
      ],
      "rules": [
        { "slot": "theme", "match": ["mecha_musume", "mecha", "mechanical", "mechanical_girl"], "output": "mecha musume" },
        { "slot": "armor", "match": ["armor", "armoured", "armored", "powered_armor", "body_armor", "integrated_armor"], "output": "heavy integrated armor" },
        {
          "slot": "material",
          "match": ["white_armor", "black_bodysuit", "metallic", "gold_trim", "gold_joints"],
          "compose": { "template": "white lacquered armor, black glossy bodysuit, gold mechanical joints", "parts": {} }
        },
        { "slot": "gear", "match": ["flight_deck", "rigging", "cannon", "weapon", "gun", "missile"], "output": "ship rigging" },
        { "slot": "pose", "match": ["full_body", "standing"], "output": "full body" }
      ]
    }
  }
}
