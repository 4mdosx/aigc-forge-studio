
# ========================================
# ComfyUI runtime
# ========================================
# Installed ComfyUI, its checkout metadata, Python venv, custom nodes.
# Version pin lives in infra/data/environment.json.
/runtime/

# ========================================
# Models and generated assets
# ========================================
/models/
/outputs/
/output/
/input/
/temp/
/datasets/
/data/*
# 采集批次的元信息要进版本库（图不进）
!/data/capture/
# 机设配方库是元信息（不含图），跟采集元信息同理进版本库
!/data/mech/
/data/capture/*
!/data/capture/
# 机设配方库是元信息（不含图），跟采集元信息同理进版本库
!/data/mech/*/
/data/capture/*/*
!/data/capture/
# 机设配方库是元信息（不含图），跟采集元信息同理进版本库
!/data/mech/*/catalog.json
!/data/capture/
# 机设配方库是元信息（不含图），跟采集元信息同理进版本库
!/data/mech/*/README.md
!/data/capture/
# 机设配方库是元信息（不含图），跟采集元信息同理进版本库
!/data/mech/*/style-anchor/
/data/capture/*/style-anchor/*
!/data/capture/
# 机设配方库是元信息（不含图），跟采集元信息同理进版本库
!/data/mech/*/style-anchor/*.json
!/data/capture/
# Blender 插件真相源：manifest 与脚本进版本库，运行产物与 .blend 二进制不进
!/data/blender-plugin/
/data/blender-plugin/runs/*
!/data/blender-plugin/runs/.gitkeep
/data/blender-plugin/scenes/*.blend
# 机设配方库是元信息（不含图），跟采集元信息同理进版本库
!/data/mech/*/style-anchor/*.tsv

