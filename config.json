{
  "comfyui": {
    "baseURL": "http://192.168.8.136:8188",
    "listen": "0.0.0.0",
    "port": 8188
  },
  "runner": {
    "//comfyUiBaseURL": "可选 在不设置的情况下使用 comfyui.baseURL",
    "host": "0.0.0.0",
    "port": 8787,
    "timeout": 600,
    "out": "outputs/runner",
    "db": "data/runner.sqlite",
    "trainerBaseURL": "http://192.168.8.136:8788",
    "//trainerBaseURL": "训练机 trainer 服务；未配置时 /train/* 路由返回 503"
  },
  "trainer": {
    "host": "0.0.0.0",
    "//host": "训练机部署：0.0.0.0 供 runner/脚本",
    "port": 8788,
    "db": "trainer/data/trainer.sqlite",
    "roots": {
      "models": "C:\\AIGC\\models",
      "training": "C:\\AIGC\\training",
      "//roots": "根目录在这里写死；API 只传 root 名字 + 相对路径，见 GET /roots"
    },
    "train": {
      "sdScriptsRoot": "C:\\AIGC\\runtime\\sd-scripts",
      "numCpuThreads": 8,
      "//train": "sd-scripts 由 infra/train_bootstrap.ps1 部署；日志落 trainer 包根 data/train/<jobId>.log"
    }
  },
  "critic": {
    "baseURL": "http://127.0.0.1:8791",
    "host": "127.0.0.1",
    "port": 8791
  },
  "blender": {
    "dataDir": "data/blender-plugin",
    "timeout": 120,
    "mcp": {
      "command": "/opt/homebrew/bin/uvx",
      "args": ["--python", "3.11", "blender-mcp"],
      "env": {
        "BLENDER_HOST": "127.0.0.1",
        "BLENDER_PORT": "9876",
        "UV_PYTHON_PREFERENCE": "only-managed"
      }
    }
  }
}
