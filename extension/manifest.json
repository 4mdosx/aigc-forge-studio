{
  "manifest_version": 3,
  "name": "AIGC Capture",
  "version": "1.0.0",
  "description": "把当前 Pinterest pin 页里的图片直传 aigc-forge capture 工作台（读登录态 DOM，runner 不碰反爬）",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8787/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "采集到 AIGC"
  },
  "minimum_chrome_version": "102"
}
