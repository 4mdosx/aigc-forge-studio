{
  "manifest_version": 3,
  "name": "GOF Capture",
  "version": "1.3.0",
  "description": "把当前页或右键图片的链接交给采集页。采集页开着才接任务，进度经 runner 推回来。",
  "permissions": ["activeTab", "scripting", "contextMenus", "notifications", "alarms"],
  "host_permissions": ["http://127.0.0.1:8787/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "采集到 GOF"
  },
  "minimum_chrome_version": "102"
}
